name: Build HIRO Client
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 9.3.0
      - name: Create project files
        run: |
          mkdir -p src/main/java/com/hiro/client/config src/main/java/com/hiro/client/module src/main/java/com/hiro/client/hud src/main/java/com/hiro/client/gui src/main/resources/assets/hiroclient/lang src/main/resources/assets/hiroclient/textures/gui
          cat > settings.gradle <<'EOF_FILE'
          pluginManagement {
              repositories {
                  maven { url = 'https://maven.fabricmc.net/' }
                  gradlePluginPortal()
                  mavenCentral()
              }
          }
          
          rootProject.name = 'HIRO-Client'
          EOF_FILE
          cat > gradle.properties <<'EOF_FILE'
          org.gradle.jvmargs=-Xmx2G
          org.gradle.parallel=true
          
          minecraft_version=1.21.11
          loader_version=0.18.4
          fabric_api_version=0.141.1+1.21.11
          loom_version=1.15.5
          
          mod_version=2.0.0
          maven_group=com.hiro
          archives_base_name=hiroclient
          EOF_FILE
          cat > build.gradle <<'EOF_FILE'
          plugins {
              id 'net.fabricmc.fabric-loom-remap' version "${loom_version}"
              id 'maven-publish'
          }
          
          version = project.mod_version
          group = project.maven_group
          
          base {
              archivesName = project.archives_base_name
          }
          
          dependencies {
              minecraft "com.mojang:minecraft:${project.minecraft_version}"
              mappings loom.officialMojangMappings()
              modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"
              modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_api_version}"
          }
          
          processResources {
              inputs.property "version", project.version
              filesMatching("fabric.mod.json") {
                  expand "version": project.version
              }
          }
          
          tasks.withType(JavaCompile).configureEach {
              options.release = 21
          }
          
          java {
              withSourcesJar()
              sourceCompatibility = JavaVersion.VERSION_21
              targetCompatibility = JavaVersion.VERSION_21
          }
          EOF_FILE
          cat > src/main/resources/fabric.mod.json <<'EOF_FILE'
          {
            "schemaVersion": 1,
            "id": "hiroclient",
            "version": "${version}",
            "name": "HIRO Client",
            "description": "Complete Fabric 1.21.11 client featuring Combat, SMP/Utility, Visuals, Movement, Bots, Themes, ClickGUI, Dropdown GUI, Radar, and FPS Graph.",
            "authors": [
              "HIRO"
            ],
            "contact": {},
            "license": "MIT",
            "icon": "assets/hiroclient/icon.png",
            "environment": "client",
            "entrypoints": {
              "client": [
                "com.hiro.client.HiroClient"
              ]
            },
            "depends": {
              "fabricloader": ">=0.16.0",
              "fabric-api": "*",
              "minecraft": ">=1.21.11",
              "java": ">=21"
            }
          }
          EOF_FILE
          cat > src/main/resources/assets/hiroclient/lang/en_us.json <<'EOF_FILE'
          {
            "key.hiroclient.open_gui": "Open HIRO GUI",
            "key.category.hiroclient.main": "HIRO CLIENT"
          }
          EOF_FILE
          cat > src/main/java/com/hiro/client/HiroClient.java <<'EOF_FILE'
          package com.hiro.client;
          
          import com.hiro.client.config.ThemeManager;
          import com.hiro.client.gui.HiroClickGuiScreen;
          import com.hiro.client.hud.HiroHudOverlay;
          import com.hiro.client.module.ModuleExecutor;
          import com.hiro.client.module.ModuleManager;
          import com.mojang.blaze3d.platform.InputConstants;
          import net.fabricmc.api.ClientModInitializer;
          import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
          import net.fabricmc.fabric.api.client.keybinding.v1.KeyBindingHelper;
          import net.fabricmc.fabric.api.client.rendering.v1.HudRenderCallback;
          import net.minecraft.client.KeyMapping;
          import net.minecraft.client.Minecraft;
          import net.minecraft.resources.Identifier;
          import org.lwjgl.glfw.GLFW;
          import org.slf4j.Logger;
          import org.slf4j.LoggerFactory;
          
          public class HiroClient implements ClientModInitializer {
              public static final String MOD_ID = "hiroclient";
              public static final Logger LOGGER = LoggerFactory.getLogger("HIRO Client");
              public static final ModuleManager MODULE_MANAGER = new ModuleManager();
              public static final ModuleExecutor MODULE_EXECUTOR = new ModuleExecutor(MODULE_MANAGER);
              public static final ThemeManager THEME_MANAGER = new ThemeManager();
          
              public static boolean useDropdownGui = false;
              private static KeyMapping openGuiKey;
          
              @Override
              public void onInitializeClient() {
                  LOGGER.info("Initializing HIRO Client Complete Edition...");
          
                  openGuiKey = KeyBindingHelper.registerKeyBinding(new KeyMapping(
                          "key.hiroclient.open_gui",
                          InputConstants.Type.KEYSYM,
                          GLFW.GLFW_KEY_RIGHT_SHIFT,
                          KeyMapping.Category.register(Identifier.fromNamespaceAndPath(MOD_ID, "main"))
                  ));
          
                  ClientTickEvents.END_CLIENT_TICK.register(client -> {
                      while (openGuiKey.consumeClick()) {
                          if (client.screen == null) {
                              client.setScreen(new HiroClickGuiScreen());
                          }
                      }
          
                      MODULE_EXECUTOR.onClientTick(Minecraft.getInstance());
                  });
          
                  HudRenderCallback.EVENT.register(new HiroHudOverlay());
              }
          }
          EOF_FILE
          cat > src/main/java/com/hiro/client/config/ThemeManager.java <<'EOF_FILE'
          package com.hiro.client.config;
          
          import java.util.List;
          
          public class ThemeManager {
              public record ThemePreset(String name, int bgColor, int panelColor, int accentColor, int textColor) {}
          
              private static final List<ThemePreset> PRESETS = List.of(
                      new ThemePreset("HIRO Noir", 0x99000000, 0xEE121216, 0xFFFFFFFF, 0xFFFFFFFF),
                      new ThemePreset("Crimson Eclipse", 0x99080406, 0xEE1B0D12, 0xFFFF3B5C, 0xFFF5F5F7),
                      new ThemePreset("Cyber Cyan", 0x99030A10, 0xEE0A1622, 0xFF00E5FF, 0xFFEAF8FF),
                      new ThemePreset("Emerald SMP", 0x99040D08, 0xEE0C1C14, 0xFF2EE58A, 0xFFECFFF5)
              );
          
              private int activeIndex = 0;
          
              public ThemePreset getCurrent() {
                  return PRESETS.get(activeIndex);
              }
          
              public void nextTheme() {
                  activeIndex = (activeIndex + 1) % PRESETS.size();
              }
          
              public List<ThemePreset> getPresets() {
                  return PRESETS;
              }
          }
